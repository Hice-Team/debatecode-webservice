# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# cloudflare (opennext)
/.open-next/
.wrangler/
.dev.vars
cloudflare-env.d.ts

# prisma generated client (regenerated via `prisma generate`)
/app/generated/

# obsolete SQLite dev db (migrated to Supabase Postgres)
prisma/dev.db

# typescript
*.tsbuildinfo
next-env.d.ts

# DB 스냅샷 — 회원 개인정보가 들어 있다. 저장소에 올리지 않는다.
/backups/

# oh-my-design 레퍼런스 카탈로그 — 440개 브랜드 DESIGN.md, 21MB.
# 서드파티 자료이고 `npx oh-my-design-cli`로 언제든 다시 받는다.
# 스킬·훅·설정은 저장소에 남기되(팀이 같은 규칙을 쓰도록) 데이터만 제외한다.
.claude/data/
