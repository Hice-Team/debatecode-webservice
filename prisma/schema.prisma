datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider   = "prisma-client-js"
  // Cloudflare Workers에는 네이티브 쿼리 엔진이 없다. driver adapter + WASM 쿼리
  // 컴파일러를 쓰는 Rust-free 클라이언트를 생성한다(네이티브 .dll.node 미포함).
  engineType = "client"
  // 클라이언트를 node_modules가 아닌 앱 소스에 생성한다. node_modules/@prisma/client
  // 를 심볼릭 링크로 추적하는 Next standalone 번들 문제(Windows EPERM)를 피하고,
  // 번들러가 일반 소스 파일로 포함하도록 한다.
  output     = "../app/generated/prisma"
}

// Supabase Auth(auth.users)가 인증/비밀번호를 소유한다.
// id는 auth.users.id와 동일한 값 — 가입 시 DB 트리거(on_auth_user_created)가 이 행을 생성한다.
model User {
  id                               String                 @id @db.Uuid
  email                            String                 @unique
  name                             String
  role                             String                 @default("user") // user | problem_setter | reviewer | admin | debate_mate | partner
  createdAt                        DateTime               @default(now())
  // DebateAI 모델 설정 (사용자별)
  aiProvider                       String                 @default("mock") // mock | anthropic | gemini | openai | grok | groq | huggingface | bridge | local
  aiModel                          String? // 예: claude-sonnet-5, gemini-2.5-flash
  // 면접·리팩토링 모드에서 쓸 debateAI 모델 (app/lib/ai/debateai-models.ts의 id)
  // 비어 있으면 DEFAULT_CODE_MODEL_ID(deepseek-coder-v2)를 쓴다
  aiCodeModel                      String?
  // AI Search에서 기본으로 열 모델 (app/lib/ai/search-models.ts의 id).
  // aiCodeModel(면접·리팩토링)과 나눠 둔다 — 코드를 따지는 일과 개념을 찾는 일은
  // 잘하는 모델이 다르고, 하나로 묶으면 한쪽은 늘 아쉬운 선택이 된다.
  aiSearchModel                    String?
  // 이용자가 직접 적는 지침 — string[]. 대화마다 앞에 붙는다.
  //
  // 한 덩어리 텍스트가 아니라 목록인 이유: 지침은 하나씩 추가되고 하나씩 후회된다.
  // 텍스트 상자로 두면 "이 줄만 빼고 싶다"에 전체를 다시 쓰게 된다.
  aiInstructions                   Json?
  // 대화에 실어 보낼 맥락의 양 — full | balanced | lean
  aiContextMode                    String?
  // 이용자가 등록한 상용 API 키(Pro Tier). AES-256-GCM 이중 암호화 저장 — app/lib/crypto.ts.
  // ⚠ AI_SECRET_KEY가 비어 있으면 encryptSecret이 평문을 그대로 돌려준다. 운영에서 그 상태가
  //   되면 이용자 키가 평문으로 쌓인다 — 콘솔 › 시스템 › 상태의 "개인정보 암호화 키"가
  //   빨간불이면 즉시 멈추고 키부터 채울 것.
  aiApiKey                         String?
  aiBaseUrl                        String? // local/bridge LLM 엔드포인트 (OpenAI 호환, 예: http://localhost:11434/v1)
  aiOnboarded                      Boolean                @default(false) // 가입 후 AI 온보딩 단계를 거쳤는지 (건너뛰기 포함)
  // Debate Free AI 일일 토큰 쿠터 — resetAt이 지나면 사용량이 0으로 초기화된다
  freeTokensUsed                   Int                    @default(0)
  freeTokensResetAt                DateTime?
  // 모델별 사용량 — { "<모델 id>": 토큰수 }. 창(freeTokensResetAt)이 넘어가면 함께 비워진다.
  // 설정 화면이 "어느 모델을 얼마나 썼는지"를 보여 주기 위한 내역이며 합계는 freeTokensUsed다.
  freeUsageByModel                 Json?
  // debateNetwork(MCP)·debateBridge 연동용 개인 액세스 토큰 — 평문은 저장하지 않고 sha256 해시만 보관
  mcpTokenHash                     String?                @unique // dcp_ 토큰의 sha256(hex)
  mcpTokenPrefix                   String? // 표시용 접두부 (예: dcp_ab12…)
  mcpTokenCreatedAt                DateTime?
  // 이메일을 실제로 받아볼 수 있는지 확인한 시각.
  //
  // auth.users.email_confirmed_at을 보지 않는다. 가입이 admin.createUser({email_confirm:true})로
  // 계정을 즉시 확정하기 때문에 그 값은 **모든 계정에서 항상 채워져 있다** — 즉 "인증됨"을
  // 뜻하지 않는다. 그걸 인증 근거로 쓰던 자리(중고거래 판매자 배지, 멘토게시판의
  // 인증 계정 전용 답변)는 사실상 전원 통과 상태였다.
  //
  // 여기 값이 들어가는 경로는 둘뿐이다.
  //   · 6자리 코드 확인 (app/lib/verification.ts)
  //   · 소셜 로그인 — 제공자가 이미 확인한 주소다
  emailVerifiedAt                  DateTime?
  consentAt                        DateTime? // 개인정보 수집·이용 동의 시각
  // debateAI 이용약관 동의 시각 — AI 기능(면접·AI Search) 최초 이용 전 받는다
  aiTermsAgreedAt                  DateTime?
  // 학습 활용 동의 (선택) — 동의한 경우에만 대화·코드가 가명처리 후 모델 개선에 쓰인다.
  // 미동의여도 AI 기능 이용에 제한이 없다(KISA 안내서: 선택 동의 거부 시 불이익 금지).
  aiTrainingConsentAt              DateTime?
  twoFactorRecoveryEmail           String?
  // 복구 이메일은 "입력했다"와 "실제로 받아볼 수 있다"가 다르다 — 코드 확인 시각을 따로 둔다
  twoFactorRecoveryEmailVerifiedAt DateTime?
  twoFactorEnabled                 Boolean                @default(false)
  twoFactorSecret                  String?
  twoFactorTempSecret              String?
  marketingConsentAt               DateTime? // 마케팅 수신 동의 시각 (선택 약관)
  // 다단계 가입 위저드에서 수집하는 프로필 — 개인정보는 AES-256으로 암호화 저장(app/lib/crypto.ts)
  birthdate                        String? // 생년월일(암호화된 문자열, enc:v1:...)
  gender                           String? // 암호화: male | female | other | undisclosed
  position                         String? // 암호화: 지망 포지션 (frontend | backend | ...)
  major                            String? // 암호화: 전공 (선택)
  interests                        Json                   @default("[]") // string[] — 관심 태그(비민감)
  referralSource                   String? // 암호화: 접하게 된 경로 (search | sns | ...)
  profileCompleted                 Boolean                @default(false) // 가입 위저드(계정+프로필 단계)를 끝까지 완료했는지
  suspendedUntil                   DateTime? // 커뮤니티 제재 만료 시각 — 미래면 글/댓글 작성 불가
  debateQAccess                    Boolean                @default(false) // debateQ 사전사용 허용 (메이트가 아니어도 debateQ 이용 가능)
  // 프로필/앱 설정
  avatarUrl                        String? // Storage 버킷 avatars의 공개 URL
  emailNotifications               Boolean                @default(true)
  preferredLanguage                String? // 코드 에디터 기본 언어
  // 시간·지역 표기 — 서버가 아니라 이용자 기준으로 시각을 그린다.
  // 비어 있으면 브라우저가 알려 주는 값을 쓴다(대부분 그게 맞다). 여행·이주처럼
  // 브라우저 값과 실제 생활권이 다를 때만 직접 고르는 자리다.
  timezone                         String? // IANA 시간대 (예: Asia/Seoul)
  dateFormat                       String? // ymd | ymdDot | mdy | dmy
  country                          String? // ISO 3166-1 alpha-2
  // 에디터 기본값 — { fontSize, tabSize, fontFamily, autocomplete, minimap, wordWrap }
  //
  // 컬럼 여섯 개로 펼치지 않는 이유는, 이 값들이 늘 함께 읽히고 함께 저장되며
  // 어느 하나로도 조회하지 않기 때문이다. 검색 조건이 되는 값만 컬럼으로 둔다.
  editorPrefs                      Json?
  // 알림 채널 — { comment, adopted, mateApply, mateResult, points, marketing }
  // emailNotifications는 이 전체를 덮는 주 스위치로 남는다(끄면 아래 값과 무관하게 안 보낸다).
  notifyPrefs                      Json?
  // 개인 맞춤 — 학습 목표, 프로필 공개 범위, AI가 답할 언어
  profileGoal                      String? // 자유 입력 (최대 120자)
  profileVisibility                String  @default("public") // public | members | private
  chatLanguage                     String? // auto | ko | en — 비어 있으면 auto
  starScore                        Int                    @default(0)
  rankBadgeVisible                 Boolean                @default(true) // 커뮤니티 글/답글에 등급 배지 노출 여부
  // 등급 비공개(rankBadgeVisible=false) 사용자를 명예의 전당에 표시할 때 쓰는 고정 익명 식별자.
  // 가입 시 1회 생성되며 익명글/익명 답글에도 같은 값을 쓴다. 예: "Anonymous 4271"
  anonymousTag                     String?                @unique
  submissions                      Submission[]
  runAttempts                      RunAttempt[]
  interviews                       InterviewSession[]
  posts                            Post[]
  comments                         Comment[]
  postLikes                        PostLike[]
  bookmarks                        Bookmark[]
  workbooks                        Workbook[]
  lessonProgress                   LessonProgress[]
  pollVotes                        PollVote[]
  loginEvents                      LoginEvent[]
  sanctions                        Sanction[]
  problemDrafts                    ProblemDraft[]
  mateApplication                  DebateMateApplication?
  debateQSessions                  DebateQSession[]
  pointEntries                     PointLedger[]
  pointRequests                    PointRequest[]
  shopOrders                       ShopOrder[]
  aiSessions                       AiSession[]
  aiFeedback                       AiFeedback[]
  rankingResets                    RankingReset[]         @relation("RankingResetTarget")
  marketListings                   MarketListing[]        @relation("MarketSeller")
  marketChatsAsBuyer               MarketChat[]           @relation("MarketBuyer")
  marketChatsAsSeller              MarketChat[]           @relation("MarketChatSeller")
  marketMessages                   MarketMessage[]        @relation("MarketMessageSender")
  debateAiChats                    DebateAiChat[]
  // 역할 위에 얹는 개별 권한 오버라이드 (app/lib/permissions.ts)
  permissionGrants                 PermissionGrant[]
  // 백업 코드(암호화된 문자열을 개별 행으로 저장)
  backupCodes                      BackupCode[]
  // WebAuthn(보안키) 등록 정보
  webauthnKeys                     WebauthnKey[]
  // 진행 중인 WebAuthn 챌린지 — 발급 시각을 함께 둔다. 만료가 없으면 한 번 발급된
  // 챌린지가 영원히 유효해져 재생 공격의 창이 닫히지 않는다.
  webauthnChallenge                String?
  webauthnChallengeAt              DateTime?
  // AI 사용 카운터 (app/lib/ai/usage-limits.ts)
  aiUsage                          AiUsageCounter[]
  judgeSessions                    JudgeSession[]
  twoFactorSessions                TwoFactorSession[]
}

// ---------- 운영: 신고 / 문의 / 제재 / 검토큐 / 디베이트메이트 신청 ----------

// 신고 — 게시글/댓글/사용자 대상. 콘솔의 신고 처리 큐에서 처리한다.
model Report {
  id           String    @id @default(cuid())
  reporterId   String    @db.Uuid
  targetType   String // post | comment | user
  targetId     String
  reason       String // spam | abuse | illegal | etc
  detail       String?
  status       String    @default("pending") // pending | resolved | dismissed
  handledById  String?   @db.Uuid
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  // ---- 트리아지 (콘솔 신고 워크스페이스) ----
  assigneeId   String?   @db.Uuid // 담당자 — 여럿이 같은 건을 동시에 붙잡지 않게
  priority     String    @default("normal") // low | normal | high | urgent
  internalNote String? // 운영진 전용 메모 (신고자·피신고자에게 보이지 않는다)
  actionTaken  String? // 처리 결과 요약 — "삭제 + 7일 글쓰기 제한" 식
  // 같은 대상에 대한 신고를 하나의 케이스로 묶는 키 ("post:abc123").
  // 접수 시점에 채워 두면 목록 조회에서 그룹핑을 DB가 해 줄 수 있다.
  dedupeKey    String?

  @@index([status, createdAt])
  @@index([dedupeKey, status])
  @@index([assigneeId, status])
}

// 문의 — 로그인/비로그인 모두. 콘솔의 문의 처리 큐에서 답변한다.
model Inquiry {
  id              String    @id @default(cuid())
  userId          String?   @db.Uuid
  email           String?
  subject         String
  body            String
  status          String    @default("open") // open | answered | closed
  answer          String?
  answeredById    String?   @db.Uuid
  createdAt       DateTime  @default(now())
  answeredAt      DateTime?
  // ---- 트리아지 ----
  assigneeId      String?   @db.Uuid
  category        String? // account | bug | suggestion | report | payment | etc
  priority        String    @default("normal") // low | normal | high | urgent
  // 첫 응답까지 걸린 시각 — 답변을 고쳐도 이 값은 그대로 둔다(SLA 지표)
  firstResponseAt DateTime?

  @@index([status, createdAt])
  @@index([assigneeId, status])
}

// 제재 이력 — 유형별 밴(열람/글/답글) + 기간(만료 없으면 영구). 해제해도 이력은 남는다.
model Sanction {
  id           String    @id @default(cuid())
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String // read | post | comment
  reason       String
  expiresAt    DateTime? // null = 영구
  active       Boolean   @default(true)
  issuedById   String?   @db.Uuid
  createdAt    DateTime  @default(now())
  // 근거 — 어느 신고/게시글 때문에 걸었는지. 이의제기가 들어왔을 때 근거 없이
  // "그때 그랬던 것 같다"로 답하지 않으려고 남긴다.
  // { reportIds?: string[], postId?: string, commentId?: string, note?: string }
  evidence     Json?
  // ---- 이의제기 ----
  appealText   String? // 사용자가 제출한 소명
  appealedAt   DateTime?
  appealStatus String? // pending | accepted | rejected
  // ---- 해제 ----
  liftedById   String?   @db.Uuid
  liftedAt     DateTime?
  liftReason   String?

  @@index([userId, active])
  @@index([active, expiresAt])
  @@index([appealStatus])
}

// ---------- 운영 기반: 런타임 설정 / 감사 로그 / 권한 오버라이드 / 매크로 ----------

// 런타임 설정 — 배포된 코드를 고치지 않고 바꿀 수 있는 값.
//
// 스키마(어떤 키가 있고 기본값이 뭔지)는 코드(app/lib/settings.ts의 SETTING_DEFS)가
// 원본이고, 이 표에는 **기본값에서 벗어난 값만** 들어온다. 그래서 이 표가 비어 있어도
// 앱은 코드 기본값으로 정상 동작한다 — 설정 계층이 새 단일 장애점이 되지 않게 한 것이다.
model AppSetting {
  key         String   @id // flag.ai_search | limit.rate.ai_ask | maintenance.enabled ...
  value       Json
  category    String // flag | limit | content | integration | maintenance
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt

  @@index([category])
}

// 감사 로그 — 콘솔에서 일어난 모든 상태 변경.
//
// 행위자 이름/역할을 스냅샷으로 박아 둔다. 계정이 삭제되거나 역할이 바뀐 뒤에도
// "그때 누가 무슨 권한으로 했는가"가 남아야 이력으로서 의미가 있다.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @db.Uuid // 시스템 자동 처리면 null
  actorName  String
  actorRole  String
  action     String // role.change | sanction.issue | setting.update | report.resolve ...
  targetType String? // user | report | inquiry | problemDraft | setting | mate | sanction
  targetId   String?
  summary    String // 사람이 읽는 한 줄
  diff       Json? // { before, after }
  ipMasked   String?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([action, createdAt(sort: Desc)])
}

// 개별 권한 오버라이드 — 역할이 주는 기본 권한 위에 얹는다.
//
// 역할을 통째로 올리지 않고 딱 한 가지만 열어 주거나(allow), 역할은 유지하되
// 문제가 된 권한만 잠글 때(deny) 쓴다. deny가 allow보다 세다.
model PermissionGrant {
  id          String    @id @default(cuid())
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission  String // app/lib/permissions.ts의 PERMISSIONS 키
  effect      String    @default("allow") // allow | deny
  reason      String?
  expiresAt   DateTime? // null = 무기한
  grantedById String?   @db.Uuid
  createdAt   DateTime  @default(now())

  @@unique([userId, permission])
  @@index([userId])
}

// 매크로(정형 답변) — 신고/문의 처리에서 매번 같은 문장을 다시 쓰지 않도록.
// 답변 품질이 담당자별로 들쭉날쭉해지는 것을 막는 목적도 있다.
model CannedResponse {
  id        String   @id @default(cuid())
  scope     String // inquiry | report | mate | sanction
  title     String
  body      String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope, active, order])
}

// 디베이트메이트 문제 검토큐 — 승인 시 payload로 Problem/TestCase를 생성한다.
model ProblemDraft {
  id                  String    @id @default(cuid())
  authorId            String    @db.Uuid
  author              User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title               String
  difficulty          Int
  category            String
  description         String
  payload             Json // { tags, timeLimitMs, starterCodes, keywords, testCases }
  status              String    @default("pending") // pending | approved | rejected
  reviewNote          String?
  reviewedById        String?   @db.Uuid
  createdAt           DateTime  @default(now())
  reviewedAt          DateTime?
  // 저작권 기증 위임서 — { donated, signerName, agreedAt, scope } (미작성 시 null = 저작권 보유)
  copyrightDelegation Json?

  @@index([status, createdAt])
  @@index([authorId, createdAt(sort: Desc)])
}

// 디베이트메이트 신청 — 승인 시 신청자 role=debate_mate. 회수 시 status=revoked.
model DebateMateApplication {
  id             String    @id @default(cuid())
  userId         String    @unique @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 신청서 PDF가 지원 동기를 대신한다 — 폼에서 두 칸을 뺐으므로 선택값이다.
  // (예전 신청서의 본문은 그대로 남아 있어 nullable로 바꾸기만 한다)
  motivation     String?
  portfolioUrl   String?
  attachmentUrl  String? // 신청서 PDF (Storage 공개 URL)
  attachmentName String? // 업로드 원본 파일명 (표시용)
  status         String    @default("pending") // pending | approved | rejected | revoked
  reviewNote     String? // 반려서/승인 메모/회수 사유 — 신청자에게 표시된다
  reviewedById   String?   @db.Uuid
  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?
}

// IP 보안 — 로그인 위치/기기 기록 및 새 IP 감지
model LoginEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipHash    String // sha256(userId:ip) — 이 사용자에게 반복된 IP인지 판별 (원문 IP 미저장)
  ipMasked  String // 표시용 마스킹 IP (예: 203.0.113.x)
  userAgent String?
  isNew     Boolean  @default(false) // 이 사용자가 처음 보는 IP에서의 로그인인지
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// 2차 인증 백업 코드.
//
// 예전에는 암호문(AES-GCM)으로 저장했다. 암호화는 복호화가 되므로 키가 새면 코드도 함께
// 샜고, 그건 2차 인증을 우회하는 값을 되돌릴 수 있는 형태로 보관한다는 뜻이다.
// 같은 저장소가 MCP 토큰은 이미 sha256만 보관하고 있다(User.mcpTokenHash) — 기준을 맞춘다.
model BackupCode {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String    @db.Uuid
  /// sha256(hex) — 평문은 발급 화면에 한 번 보여 주고 어디에도 남기지 않는다
  codeHash  String    @unique
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, used])
}

// WebAuthn(보안키) 등록 정보.
//
// credentialId를 별도 컬럼으로 올려 둔다. JSON 안에 묻어 두면 (1) 중복 등록을 막는
// excludeCredentials가 엉뚱한 값을 넘기게 되고(실제로 행 UUID를 넘기고 있었다),
// (2) 인증 단계에서 credential로 사용자를 찾을 수가 없다.
model WebauthnKey {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String    @db.Uuid
  name         String? // 사용자가 붙이는 이름
  /// base64url — 인증기가 돌려주는 credential id 그대로
  credentialId String    @unique
  /// base64url COSE 공개키
  publicKey    String
  /// 복제된 인증기 탐지용 서명 카운터 — 인증할 때마다 올라간다
  counter      Int       @default(0)
  transports   Json      @default("[]")
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

model Problem {
  id              Int              @id @default(autoincrement())
  slug            String           @unique
  title           String
  difficulty      Int // 1=입문 2=초급 3=중급 4=고급
  category        String // "해시" | "스택" | "DP" | "그리디" | "그래프" | "자료구조"
  tags            Json // string[]
  description     String // 한국어 markdown
  timeLimitMs     Int              @default(3000)
  starterCodes    Json // { javascript: string, python: string }
  keywords        Json // string[] — 면접 평가 기대 키워드
  company         String? // 기출 기업명 (기출별 분류용, 예: "카카오")
  examYear        String? // 기출 연도 (예: "2024")
  testCases       TestCase[]
  submissions     Submission[]
  runAttempts     RunAttempt[]
  bookmarks       Bookmark[]
  workbookItems   WorkbookItem[]
  debateQSessions DebateQSession[]
  debateAiChats   DebateAiChat[]
  setItems        ProblemSetItem[]
  judgeSessions   JudgeSession[]
}

// ---------- 코딩테스트: 편성된 문제집 세트 ----------

// 운영진이 콘솔에서 편성하는 문제 세트 — 기출 모음집, 실전 모의고사, 테마별 문제집.
// /contests 라이브러리에 카드로 노출되고, 세트 상세에서 순서대로 풀 수 있다.
model ProblemSet {
  id           Int              @id @default(autoincrement())
  slug         String           @unique
  title        String
  kind         String           @default("exam") // exam(기출 모음) | mock(실전 모의고사) | theme(테마별)
  description  String
  company      String? // kind=exam일 때 출제 기업
  examYear     String? // 기출 연도
  difficulty   Int              @default(2) // 세트 대표 난이도 1~4
  timeLimitMin Int? // 세트 전체 권장 제한 시간(분). null이면 무제한
  tags         Json             @default("[]") // string[]
  published    Boolean          @default(false)
  order        Int              @default(0) // 라이브러리 정렬 순서 (작을수록 앞)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  items        ProblemSetItem[]

  @@index([published, kind, order])
}

model ProblemSetItem {
  id        String     @id @default(cuid())
  setId     Int
  problemId Int
  order     Int        @default(0)
  set       ProblemSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  problem   Problem    @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([setId, problemId])
  @@index([problemId])
}

// 나만의 문제집 (스크랩)
model Bookmark {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  problemId Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([problemId])
}

model Workbook {
  id        String         @id @default(cuid())
  userId    String         @db.Uuid
  name      String
  isDefault Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WorkbookItem[]

  @@unique([userId, name])
  @@index([userId, isDefault])
}

model WorkbookItem {
  id         String   @id @default(cuid())
  workbookId String
  problemId  Int
  createdAt  DateTime @default(now())
  workbook   Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  problem    Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([workbookId, problemId])
  @@index([problemId])
}

model TestCase {
  id        Int     @id @default(autoincrement())
  problemId Int
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input     Json // 인자 배열 e.g. [[2,7,11,15], 9]
  expected  Json // 기대 반환값 e.g. [0,1]
  isHidden  Boolean @default(false)
  order     Int     @default(0)

  // 문제를 열 때마다 problemId로 통째로 읽는다. Postgres는 외래키에 인덱스를
  // 자동으로 만들지 않으므로 여기 없으면 매번 순차 스캔이다.
  @@index([problemId, order])
}

model Submission {
  id          String            @id @default(cuid())
  userId      String            @db.Uuid
  problemId   Int
  code        String
  language    String // "javascript" | "python"
  status      String // "PASS" | "FAIL" | "ERROR" | "TIMEOUT"
  passedCount Int
  totalCount  Int
  runtimeMs   Int?
  createdAt   DateTime          @default(now())
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem     Problem           @relation(fields: [problemId], references: [id])
  interview   InterviewSession?

  @@index([userId, createdAt(sort: Desc)])
  @@index([problemId, status])
}

// 실행/제출 시도 기록 — 워크스페이스의 시도횟수 탭 테이블. 실행 시각·코드·통과 여부를 남기고,
// 항목을 누르면 그 시점의 코드를 에디터로 복원한다.
model RunAttempt {
  id          String   @id @default(cuid())
  userId      String   @db.Uuid
  problemId   Int
  code        String
  language    String // "javascript" | "python"
  status      String // "PASS" | "FAIL" | "ERROR" | "TIMEOUT"
  passedCount Int
  totalCount  Int
  kind        String   @default("run") // run | submit
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId, problemId, createdAt(sort: Desc)])
}

model InterviewSession {
  id           String     @id @default(cuid())
  submissionId String     @unique
  userId       String     @db.Uuid
  status       String     @default("ACTIVE") // ACTIVE | COMPLETED
  round        Int        @default(0)
  // 면접장 입장 전에 고른 설정 — { rounds, level, focus } (app/lib/ai/interview-config.ts)
  config       Json?
  messages     Json       @default("[]") // ChatMessage[]
  analysis     Json? // CodeAnalysis
  report       Json? // DefenseReport
  defenseScore Int?
  weakKeywords Json       @default("[]") // string[]
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

// debateQ — 디베이트메이트 전용: AI가 생성한 결함 코드를 수정하며 변론하는 모드
model DebateQSession {
  id          String   @id @default(cuid())
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId   Int
  problem     Problem  @relation(fields: [problemId], references: [id])
  status      String   @default("ACTIVE") // ACTIVE | COMPLETED
  round       Int      @default(1)
  language    String // javascript | python
  initialCode String // AI가 생성한 결함 코드 원본
  currentCode String // 사용자가 수정 중인 최신 코드
  flawHints   Json     @default("[]") // string[] — 심어진 결함 요약 (평가 컨텍스트)
  messages    Json     @default("[]") // ChatMessage[]
  attempts    Int      @default(0) // 실행(채점) 시도 횟수
  codeHistory Json     @default("[]") // CodeRecord[] — AI가 생성한 모든 코드 버전 (열람용)
  report      Json? // DefenseReport
  score       Int?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([problemId])
}

// debateAI 탭의 대화 — 이용자·문제당 하나만 둔다.
//
// 탭을 닫거나 새로고침해도 대화가 이어져야 하고, 같은 문제를 다시 열었을 때
// 지난 대화가 그대로 있어야 "이 문제를 어디까지 이해했는지"가 남는다.
// 여러 개를 만들지 않는 대신, 이용자가 원할 때 초기화(DELETE)할 수 있게 했다.
model DebateAiChat {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId Int
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  // general 시그니처·디베이트 모드의 학습 대화
  // refactor 리팩토링모드 — AI가 만든 결함 코드를 두고 나누는 대화
  // 두 대화는 전제가 달라(내 코드 vs AI의 결함 코드) 한 줄기로 이으면 문맥이 어긋난다.
  scope     String   @default("general")
  messages  Json     @default("[]") // { role, content, command? }[]
  model     String? // 마지막으로 고른 모델 id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, problemId, scope])
  @@index([userId, updatedAt(sort: Desc)])
}

model Post {
  id                  String         @id @default(cuid())
  board               String // free | mentor | qna | market | sns
  type                String         @default("text") // text | link (SNS 게시판은 link)
  title               String
  content             String
  url                 String? // type=link일 때 외부 링크
  snsPlatform         String? // velog | instagram | x | blog | etc (board=sns일 때)
  authorId            String         @db.Uuid
  // 작성자 익명 표시 — true면 목록/상세에서 작성자명 대신 anonymousTag를 쓴다
  anonymous           Boolean        @default(false)
  // 비밀글 — 작성자 본인과 관리자/디베이트메이트만 열람 가능 (문의게시판은 자동 true)
  secret              Boolean        @default(false)
  // 인증된 사용자에게만 답변 받기 — 멘토게시판에서 선택. 열람은 전원, 답글은 메이트/관리자만
  verifiedOnlyReplies Boolean        @default(false)
  // 채택 포인트 — 문의게시판에서 질문자가 정한다(10~50P).
  // 질문마다 급한 정도가 다른데 지급액이 고정이면, 답변자 입장에서 어느 질문을 먼저 볼지
  // 정할 근거가 없다. 질문자가 걸어 둔 포인트가 그 신호가 된다.
  bounty              Int?
  // 채택된 답변 — 값이 있으면 더 이상 답글을 달 수 없다
  adoptedCommentId    String?        @unique
  adoptedAt           DateTime?
  // 상단 고정 — 공지사항을 모든 게시판 위에 붙여 둔다.
  // 게시판별이 아니라 전역이다. 공지는 "이 게시판을 보는 사람"이 아니라
  // "커뮤니티에 온 사람" 전부가 봐야 하는 내용이라서다.
  pinned              Boolean        @default(false)
  pinnedAt            DateTime?
  viewCount           Int            @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime? // 마지막 수정 시각 (수정된 적 없으면 null)
  author              User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments            Comment[]
  attachments         Attachment[]
  likes               PostLike[]
  listing             MarketListing?

  @@index([board, createdAt(sort: Desc)])
  @@index([pinned, pinnedAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
}

// 게시글 좋아요
model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

// 댓글/답글 — parentId가 null이면 최상위 댓글, 있으면 해당 댓글의 답글
model Comment {
  id        String    @id @default(cuid())
  postId    String
  authorId  String    @db.Uuid
  parentId  String?
  anonymous Boolean   @default(false) // 익명 답글 — 작성자명 대신 anonymousTag 표시
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime? // 마지막 수정 시각 (수정된 적 없으면 null)
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  @@index([postId])
  @@index([authorId, createdAt(sort: Desc)])
}

// 게시글 첨부 — 파일/이미지(Storage 업로드), 유튜브/외부 링크, 코드 스니펫, 투표
model Attachment {
  id        String     @id @default(cuid())
  postId    String
  kind      String // file | image | youtube | link | code | poll
  url       String? // Storage 공개 URL 또는 외부 링크/유튜브 URL
  label     String? // 파일명 / 링크 제목 / 투표 질문
  content   String? // kind=code일 때 스니펫, kind=poll일 때 JSON {options: string[]}
  language  String? // kind=code일 때 언어
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes     PollVote[]

  @@index([postId])
}

// 투표 응답 — 첨부(kind=poll) 1건당 사용자 1표, 다시 누르면 취소/변경
model PollVote {
  id           String     @id @default(cuid())
  attachmentId String
  userId       String     @db.Uuid
  optionIndex  Int
  createdAt    DateTime   @default(now())
  attachment   Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([attachmentId, userId])
  @@index([userId])
}

// 전체 공지 팝업 — active인 공지 중 최신 1건을 사이트 전역 팝업으로 노출
model Announcement {
  id         String    @id @default(cuid())
  title      String
  content    String // markdown
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? // 마지막 수정 시각
  // 포스터 이미지 (Storage 공개 URL) — 있으면 팝업 상단에 썸네일로 깔린다
  imageUrl   String?
  // 본문 중심(text)인지 이미지 중심(poster)인지. poster는 본문 없이도 성립한다.
  variant    String    @default("text")
  // 클릭 동작 — none: 없음 / post: 커뮤니티 글 / url: 외부 링크 / mail: 문의 메일
  linkType   String    @default("none")
  linkTarget String? // postId | URL | 이메일 주소
  linkLabel  String? // 버튼 문구 (비우면 기본값)
  // 게시 기간 — 비우면 즉시~무기한. 여러 팝업을 겹쳐 띄울 때 기간으로 정리한다.
  startsAt   DateTime?
  endsAt     DateTime?
  order      Int       @default(0) // 여러 개가 동시에 뜰 때의 순서

  @@index([active, order])
}

// ---------- debateStudy: 코스웨어 ----------

model Course {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  description String
  language    String // "python" | "javascript" 등
  order       Int      @default(0)
  lessons     Lesson[]
}

model Lesson {
  id       Int              @id @default(autoincrement())
  courseId Int
  slug     String
  title    String
  content  String // 한국어 markdown (텍스트 + 코드 예제)
  order    Int              @default(0)
  course   Course           @relation(fields: [courseId], references: [id])
  progress LessonProgress[]

  @@unique([courseId, slug])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String   @db.Uuid
  lessonId    Int
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

// ---------- 디베이트메이트: 포인트 원장 / 활동 인증 / 디베이트샵 ----------

// 포인트 원장 — 잔액은 이 테이블의 amount 합으로만 구한다(별도 잔액 컬럼을 두지 않는다).
// 적립은 양수, 사용(상점 주문)은 음수. 승인 완료된 건만 기록되며 취소는 반대 부호 행을 추가한다.
model PointLedger {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int // 적립 +, 사용 -
  kind      String // problem_approved | mentor_adopted | qna_adopted | sns_approved | bonus | shop_purchase | shop_refund | admin_adjust
  memo      String?
  refType   String? // problemDraft | post | comment | shopOrder | pointRequest
  refId     String?
  createdAt DateTime @default(now())

  // 같은 활동으로 두 번 적립되지 않게 막는다 (예: 같은 답글 채택 재실행)
  @@unique([userId, kind, refType, refId])
  @@index([userId, createdAt(sort: Desc)])
}

// 활동 인증 신청 — 관리자 승인 후에야 원장에 적립된다(신청 시점에는 적립되지 않는다).
model PointRequest {
  id           String    @id @default(cuid())
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         String // sns_promo | etc
  status       String    @default("pending") // pending | approved | rejected
  amount       Int // 승인 시 지급할 포인트 (신청 시 정책값으로 채움)
  // sns_promo: { platform, url, postId?, description }
  payload      Json      @default("{}")
  proofUrl     String? // 인증 스크린샷 (Storage)
  reviewNote   String?
  reviewedById String?   @db.Uuid
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?

  @@index([status, createdAt])
  @@index([userId, createdAt(sort: Desc)])
}

// 디베이트샵 상품 — 기프티콘 카탈로그. 1,000P = 1,000원.
model ShopProduct {
  id          String      @id @default(cuid())
  name        String
  brand       String
  // 어느 상점에 걸리는가 — general(전 회원) | mate(디베이트메이트 전용).
  // 구매 흐름(포인트 차감 → 운영자 승인 → 연락처로 발송)은 둘이 같고, 카탈로그만 다르다.
  scope       String      @default("general")
  description String?
  stock       Int? // null = 무제한
  priceKrw    Int // 정가(원). 필요 포인트와 1:1
  imageUrl    String?
  // 발급 채널 — kakao_biz(카카오쇼핑 for biz) | giftishow(기프티쇼) | manual(수동 발급)
  provider    String      @default("manual")
  providerSku String?
  active      Boolean     @default(true)
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  orders      ShopOrder[]

  @@index([active, order])
  @@index([scope, active, order])
}

// 상점 주문 — 주문 시 포인트를 즉시 차감(원장에 음수 기록)하고, 쿠폰 발급은 별도 단계로 확정한다.
// 발급 실패/취소 시 환불 원장을 추가한다.
model ShopOrder {
  id              String      @id @default(cuid())
  userId          String      @db.Uuid
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId       String
  product         ShopProduct @relation(fields: [productId], references: [id])
  pointsSpent     Int
  status          String      @default("requested") // requested | fulfilled | canceled | failed
  // 발급 결과 — 쿠폰 코드는 발급 채널이 돌려준 값. 수동 발급이면 운영자가 입력한다.
  couponCode      String?
  couponExpiresAt DateTime?
  providerOrderId String?
  failureReason   String?
  // 발급된 쿠폰을 보낼 곳 — 주문 시 이용자가 입력한다.
  // 예전에는 어디로 보낼지 기록이 없어 운영자가 따로 물어봐야 했다.
  contact         String?
  contactType     String      @default("email") // email | phone
  adminMemo       String?
  createdAt       DateTime    @default(now())
  fulfilledAt     DateTime?

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([productId])
}

// 출시 알림 신청 — 대기 페이지(debate-commingsoon)에서 이메일만 받는다.
//
// 회원가입이 아니다. 출시 소식을 한 번 보내기 위한 최소 수집이라 이메일 외에는 두지 않는다.
// 같은 주소가 여러 번 오면 덮어쓴다(unique) — 중복 발송을 막기 위해서다.
model LaunchNotify {
  id         String    @id @default(cuid())
  email      String    @unique
  source     String    @default("coming-soon") // 어느 화면에서 남겼는지
  notifiedAt DateTime? // 출시 메일을 실제로 보낸 시각
  createdAt  DateTime  @default(now())

  @@index([createdAt(sort: Desc)])
}

// 이메일 인증코드 — 가입 확인, 복구 이메일 등록 등.
//
// 평문 코드는 저장하지 않는다(sha256만). DB가 새더라도 코드 자체는 재사용할 수 없어야 한다.
// attempts로 무차별 대입을 막고, expiresAt로 수명을 제한한다.
model EmailVerification {
  id         String    @id @default(cuid())
  email      String
  codeHash   String // sha256(hex)
  purpose    String // signup | recovery_email | email_change
  userId     String?   @db.Uuid
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

// ---------- 마케팅 ----------

// 홍보성 이메일 수신 동의자 명단.
//
// User.marketingConsentAt과 따로 두는 이유가 셋 있다.
//   1) 회원이 아닌 사람(출시 알림 신청자 등)도 같은 명단에 들어온다.
//   2) 수신거부는 계정과 무관하게 링크 하나로 즉시 되어야 한다(unsubscribeToken).
//   3) 발송 대상을 뽑을 때 User 전체를 훑지 않고 이 표만 읽으면 된다.
// 동의를 철회하면 행을 지우지 않고 unsubscribedAt을 채운다 — 재동의 이력을 남기기 위함이다.
model MarketingContact {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  userId           String?   @db.Uuid // 회원이면 연결, 탈퇴하면 null로 끊는다
  source           String    @default("signup") // signup | settings | launch_notify | manual
  consentedAt      DateTime  @default(now())
  unsubscribedAt   DateTime? // 값이 있으면 발송 대상에서 제외
  unsubscribeToken String    @unique
  lastSentAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([unsubscribedAt, consentedAt(sort: Desc)])
}

// 홍보 메일 발송 건 — 콘솔에서 작성하고 보낸다. 보낸 뒤에는 수정하지 않고 기록으로 남긴다.
model EmailCampaign {
  id             String    @id @default(cuid())
  subject        String
  body           String // 마크다운
  audience       String    @default("all") // all | members | guests
  status         String    @default("draft") // draft | sending | sent | failed
  recipientCount Int       @default(0)
  sentCount      Int       @default(0)
  failedCount    Int       @default(0)
  errorMessage   String?
  createdById    String    @db.Uuid
  createdAt      DateTime  @default(now())
  sentAt         DateTime?

  @@index([status, createdAt(sort: Desc)])
}

// ---------- AI Search: 대화 세션 ----------

// AI Search 대화 세션 — 사용자당 최근 1개만 활성으로 유지한다.
// '새로 시작하기'를 고르면 기존 세션을 삭제하고 새 세션을 만든다.
model AiSession {
  id           String      @id @default(cuid())
  userId       String      @db.Uuid
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String? // 첫 질문에서 뽑은 요약 제목
  model        String? // 이 세션에서 마지막으로 고른 모델 id (app/lib/ai/search-models.ts)
  effort       String? // 마지막으로 고른 사고 강도 (low | medium | high)
  // 가져온 세션이면 원본 파일 정보를 남긴다 — 최초 질문 위에 카드로 한 번만 보여준다
  importedFrom Json? // { fileName, messageCount, importedAt }
  // 다른 대화에서 갈라져 나온 세션이면 원본을 남긴다 — { sessionId, title, messageId, at }
  // 화면 위에 "…에서 분기됨 · 원본 보기" 줄로 한 번만 보여 준다.
  branchedFrom Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  messages     AiMessage[]

  @@index([userId, updatedAt(sort: Desc)])
}

model AiMessage {
  id               String       @id @default(cuid())
  sessionId        String
  session          AiSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role             String // user | assistant
  content          String
  // 첨부 메타데이터 — [{ kind: image|file, name, url, mime, size }]
  // 파일 첨부와 "모델이 그 파일을 이해하는가"는 별개 문제라 데이터만 보관한다.
  attachments      Json         @default("[]")
  // 답변 근거 문서 — [{ source, title, href }]. 검색 계층 결과이며 AI 계층과 분리돼 있다.
  sources          Json         @default("[]")
  model            String? // 이 답변을 만든 모델 id — 투명성 고지에 쓴다
  // 이 답변에 든 토큰 — 공급자가 usage를 주면 그 값, 아니면 추정치.
  // 어디까지가 실측인지 섞이면 안 되므로 estimated로 구분해 둔다.
  promptTokens     Int?
  completionTokens Int?
  tokensEstimated  Boolean      @default(false)
  // 생성에 쓴 사고 강도 (low | medium | high)
  effort           String?
  createdAt        DateTime     @default(now())
  feedback         AiFeedback[]

  @@index([sessionId, createdAt])
}

/// AI Search 답변 피드백 — 답변 하나에 이용자 한 명당 한 건(다시 누르면 갱신·취소).
///
/// 신고(Report)와는 목적이 다르다. 신고는 법적 문제를 처리 큐에 올리는 것이고,
/// 이쪽은 "이 답변이 쓸모 있었는가"를 모아 모델·프롬프트를 고치는 데 쓴다.
/// 그래서 사유는 자유 서술이 아니라 고정된 항목(reasons)으로 받아 집계할 수 있게 했다.
/// 중고 거래 매물 — 커뮤니티 글(board='market')에 붙는 거래 정보.
///
/// 왜 Post를 그대로 쓰지 않고 따로 두는가. 거래에는 글에 없는 상태가 있다 —
/// 가격, 예약/판매완료, 직거래 장소, 택배비. 이걸 Post에 컬럼으로 더하면
/// 자유게시판 글에도 쓰지 않는 칸이 여덟 개 붙는다. 1:1로 분리해 둔다.
model MarketListing {
  id             String  @id @default(cuid())
  postId         String  @unique
  post           Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  sellerId       String  @db.Uuid
  seller         User    @relation("MarketSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  /// 원 단위. 0이면 나눔.
  price          Int
  /// selling | reserved | sold — 판매자와 구매자가 채팅·게시글·대시보드 어디서든 바꾼다
  status         String  @default("selling")
  /// new | like_new | used | worn
  condition      String  @default("used")
  /// 상품 상태 설명 — "사용감 있음, 모서리 찍힘" 같은 것
  conditionNote  String?
  /// 직거래 희망지. 없으면 택배만.
  region         String?
  shipping       Boolean @default(false)
  /// 택배비(원). null이면 착불 또는 미정.
  shippingFee    Int?
  /// 판매자가 실명 인증(이메일 인증)을 마친 상태로 올렸는가 — 올린 시점의 사실을 박아 둔다
  sellerVerified Boolean @default(false)

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  soldAt    DateTime?
  chats     MarketChat[]

  @@index([status, createdAt(sort: Desc)])
  @@index([sellerId])
}

/// 매물 하나에 대한 판매자↔구매자 1:1 대화방.
///
/// 삭제는 각자 따로 한다. 한쪽이 지웠다고 상대의 기록까지 사라지면
/// 거래 분쟁에서 남은 사람이 근거를 잃는다. 양쪽이 모두 지운 뒤에 정리한다.
model MarketChat {
  id        String        @id @default(cuid())
  listingId String
  listing   MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String        @db.Uuid
  buyer     User          @relation("MarketBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId  String        @db.Uuid
  seller    User          @relation("MarketChatSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  /// 각자의 숨김 시점 — 목록에서 감출 뿐 상대의 기록은 남는다
  buyerHiddenAt  DateTime?
  sellerHiddenAt DateTime?
  /// 마지막 메시지 시각 — 목록 정렬용(매번 집계하지 않으려고 둔다)
  lastMessageAt  DateTime  @default(now())

  createdAt DateTime        @default(now())
  messages  MarketMessage[]

  @@unique([listingId, buyerId])
  @@index([buyerId, lastMessageAt(sort: Desc)])
  @@index([sellerId, lastMessageAt(sort: Desc)])
}

/// 거래 대화 메시지. 수정·삭제 가능(요구사항: 대시보드에서 수정/삭제).
///
/// 삭제는 행을 지우지 않고 deletedAt만 남긴다 — 대화 흐름에 구멍이 나면
/// 상대는 무슨 말이 오갔는지 알 수 없게 되고, 분쟁 시 확인할 근거도 사라진다.
model MarketMessage {
  id         String     @id @default(cuid())
  chatId     String
  chat       MarketChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderId   String     @db.Uuid
  sender     User       @relation("MarketMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  content    String
  /// 거래 상태를 바꾼 시스템 알림이면 그 상태값 — 대화 흐름에 남겨 둔다
  systemKind String?
  createdAt  DateTime   @default(now())
  editedAt   DateTime?
  deletedAt  DateTime?
  readAt     DateTime?

  @@index([chatId, createdAt])
}

/// 개인 랭킹 초기화 기록 — 부정행위가 확인된 계정의 순위를 그 시점부터 0으로 되돌린다.
///
/// 활동 기록(제출·게시글 등) 자체는 지우지 않는다. 학습 이력이자 신고 처리의 근거이므로
/// 남겨 둬야 하고, 지우면 되돌릴 수도 없다. 대신 랭킹 집계에서 이 계정을 그 구간 동안
/// 빼는 방식으로 "초기화"한다(app/lib/ranking.ts).
model RankingReset {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  user      User     @relation("RankingResetTarget", fields: [userId], references: [id], onDelete: Cascade)
  /// 이 시각 이후의 집계 구간에서 해당 계정을 제외한다
  resetAt   DateTime @default(now())
  reason    String
  /// 처리한 운영자
  byId      String?  @db.Uuid
  createdAt DateTime @default(now())

  @@index([userId, resetAt(sort: Desc)])
  @@index([resetAt(sort: Desc)])
}

model AiFeedback {
  id        String    @id @default(cuid())
  messageId String
  message   AiMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    String // up | down
  /// 부정 평가 사유 코드 배열 — app/lib/ai/feedback-reasons.ts 가 단일 출처
  reasons   Json      @default("[]")
  comment   String? // 이용자가 직접 적은 보충 설명 (선택)
  /// 어떤 모델에 대한 평가였는지 — 나중에 모델을 바꿔도 집계가 흐려지지 않게 박아 둔다
  model     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([messageId, userId])
  @@index([rating, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

/// 가입 위저드 임시 저장소.
///
/// 예전에는 단계마다 곧바로 User를 갱신했다. 그래서 중간에 이탈하면 이름만 있고 프로필은 빈,
/// 로그인도 안 되는 반쪽짜리 계정이 남았다. 이제 마지막 단계를 마쳐야 계정이 만들어지고,
/// 그전까지 입력한 값은 전부 여기에만 있다.
///
/// 비밀번호는 마지막에 Supabase로 넘겨야 해서 보관할 수밖에 없다 — 평문 대신 AES-256-GCM으로
/// 암호화해 두고(app/lib/crypto.ts), 가입이 끝나면 이 행을 즉시 지운다.
model SignupDraft {
  id    String  @id @default(cuid())
  /// 쿠키에 심는 임의 토큰 — 이어하기의 1차 열쇠
  token String  @unique
  /// 쿠키를 잃었을 때를 위한 2차 확인용. 단독으로는 열쇠가 되지 않는다(공유 IP 문제).
  ip    String?

  email       String?
  passwordEnc String?
  marketing   Boolean   @default(false)
  consentedAt DateTime?

  nickname     String?
  birthdateEnc String?
  genderEnc    String?

  positionEnc String?
  majorEnc    String?
  interests   Json    @default("[]")
  referralEnc String?

  /// 돌아왔을 때 어느 단계부터 보여 줄지
  step String @default("consent")

  /// 소셜 가입처럼 이미 세션이 있는 경우의 사용자 id
  userId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// 생성 12시간 뒤. 지난 행은 조회에서 제외되고 정리 대상이 된다.
  expiresAt DateTime

  @@index([ip, expiresAt])
  @@index([expiresAt])
}

// ---------- 채점 · AI 사용량 ----------

/// 채점 세션 — 제출의 신뢰 근거.
///
/// 예전에는 브라우저가 "PASS, 10/10"이라고 말하면 서버가 그대로 믿었다. 채점기가
/// 브라우저에 있으니 그 값은 이용자가 정하는 값이고, 그 값에 스타점수·디베이트포인트가
/// 걸려 있었다. 포인트는 기프티콘으로 나가므로 이것은 사실상 결제 금액을 클라이언트가
/// 정하는 구조였다.
///
/// 그래서 판정을 서버로 되가져온다. 흐름은 이렇다.
///   1. 서버가 세션을 열고 **입력만** 내려보낸다 — 기대 출력은 나가지 않는다.
///   2. 브라우저 워커가 코드를 돌려 각 케이스의 **실제 출력**을 만든다.
///   3. 서버가 기대 출력과 비교해 pass/fail을 **직접 판정**하고 기록한다.
///
/// 이용자는 이제 "통과했다"고 주장할 수 없다. 정답 출력을 만들어 내야만 통과하며,
/// 그러려면 실제로 문제를 풀어야 한다. 코드 실행기를 서버로 옮기게 되면 2단계만
/// 갈아 끼우면 되고 이 계약은 그대로 남는다.
model JudgeSession {
  id         String    @id @default(cuid())
  userId     String?   @db.Uuid // 비로그인 실행도 예제 케이스로는 허용한다
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId  Int
  problem    Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  language   String // javascript | python
  /// 세션을 열 때의 코드 sha256 — 제출 코드가 채점한 코드와 같은지 대조한다
  codeHash   String
  /// run(예제만) | submit(전체 · 히든 포함)
  kind       String    @default("run")
  /// 이 세션이 요구하는 케이스 id 목록 — 누락·추가를 판별한다
  caseIds    Json      @default("[]")
  /// 한 번 쓰면 닫는다. 같은 세션으로 두 번 제출할 수 없다.
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
}

/// AI 사용 카운터 — 토큰이 아니라 **횟수**로 센다.
///
/// 토큰으로 세면 이용자가 자기 잔량을 예측할 수 없다. "오늘 몇 번 더 물어볼 수 있는가"는
/// 셀 수 있지만 "62,400토큰이 남았다"는 셀 수 없고, 같은 질문이 모델에 따라 다른 양을
/// 먹기 때문에 같은 행동이 다른 값을 남긴다. 한도는 이용자가 예측할 수 있어야 지킬 수 있다.
///
/// 한도는 **서비스가 요금을 대는 경우에만** 적용한다. 개인 API 키를 등록했거나 로컬
/// 모델을 연결한 이용자는 자기 비용으로 쓰는 것이므로 세지 않는다.
model AiUsageCounter {
  id      String   @id @default(cuid())
  userId  String   @db.Uuid
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ai-search | debateai (면접관은 한도가 없어 여기 들어오지 않는다)
  surface String
  /// 한도가 걸리는 단위. 전역이면 "-", 문제 단위면 문제 id.
  scope   String   @default("-")
  count   Int      @default(0)
  /// 이 시각이 지나면 count를 0부터 다시 센다
  resetAt DateTime

  @@unique([userId, surface, scope])
  @@index([resetAt])
}

/// 로그인 세션 하나가 2차 인증을 통과했다는 기록.
///
/// ── 왜 세션 단위인가 ────────────────────────────────────────────────────────
/// Supabase는 비밀번호가 맞으면 그 자리에서 세션을 발급한다. 그 사이에 끼어들어
/// "코드를 맞힐 때까지 세션을 주지 않는" 구조를 만들려면 Supabase의 MFA(AAL2)로
/// 갈아타야 하는데, 그러면 이미 만들어 둔 TOTP 비밀키·백업 코드·보안키를 전부
/// 그쪽 저장소로 옮겨야 한다.
///
/// 그래서 반대로 접근한다. 세션은 그대로 발급하되, **2차 인증을 통과하지 않은 세션은
/// 아무것도 열지 못하게** 한다(app/lib/dal.ts의 verifySession). 통과하면 그 사실을
/// 세션 id에 붙여 여기 남긴다. 이용자 입장의 결과는 같고, 기존 인증 수단을 그대로 쓴다.
///
/// 만료를 두는 이유: 기기를 한 번 통과시켰다고 영원히 믿을 수는 없다. 창이 지나면
/// 다시 묻는다 — 로그인 자체가 살아 있어도 그렇다.
model TwoFactorSession {
  id         String   @id @default(cuid())
  /// Supabase 액세스 토큰의 session_id. 이 값이 세션의 신원이다.
  sessionId  String   @unique
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 무엇으로 통과했는가 — totp | backup | webauthn | recovery_email
  method     String
  /// 통과한 기기를 나중에 알아볼 수 있게 남긴다(설정 화면의 목록용)
  userAgent  String?
  ipMasked   String?
  verifiedAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId, verifiedAt(sort: Desc)])
  @@index([expiresAt])
}
