# .dev.vars — 로컬 Workers 미리보기(`npm run preview`)에서 읽는 환경변수.
#
# 이 파일을 `.dev.vars`로 복사해 값을 채운다(.dev.vars는 gitignore됨).
# `next dev`는 `.env`를 읽고, `npm run preview`(workerd)는 `.dev.vars`를 읽는다 —
# 두 파일의 값이 어긋나면 "dev에서는 되는데 preview에서 안 되는" 상황이 된다.
#
# ⚠ NEXT_PUBLIC_* 은 런타임 변수가 아니라 **빌드 시점에 번들로 인라인**된다.
#   프로덕션에서는 `wrangler secret put`이 아니라 빌드 환경변수로 넣어야 한다.
#   자세한 내용은 DEPLOY.md 참고.

# ---------- 필수 ----------

# 로컬 미리보기(`npm run preview`)에서 Next가 어느 .env 파일을 읽을지 정한다.
# 비워 두면 "production"으로 간주되어 .env.development가 무시된다 — OpenNext 공식 권장값.
NEXTJS_ENV=development


# Supabase Postgres — Workers에서는 pooler(6543, pgbouncer) URL을 써야 한다
DATABASE_URL=
# 마이그레이션용 직결 URL (5432)
DIRECT_URL=

# 빌드 변수 (NEXT_PUBLIC_*) — 클라이언트 번들에 인라인된다
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 — 절대 클라이언트에 노출 금지
SUPABASE_SERVICE_ROLE_KEY=

# 사용자 저장 개인정보/API 키 암호화 키 (AES-256, app/lib/crypto.ts)
AI_SECRET_KEY=
# 이중 암호화 2차 키 (권장, 없으면 1차 키만 사용)
AI_SECRET_KEY_2=

# ---------- 선택: 사이트 정보 ----------

# 절대 URL이 필요한 곳(메일 링크, OAuth 리다이렉트)에서 쓴다
NEXT_PUBLIC_SITE_URL=

# ---------- 선택: 소셜 로그인 ----------

# 네이버 개발자센터 애플리케이션 정보
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ---------- 메일 발송 (SMTP) ----------
# 문의 답변 / 복구 이메일 인증코드 / 홍보 메일이 이 경로로 나간다.
# 미설정이면 dry-run — 콘솔 화면은 동작하되 실제로 보내지 않는다(app/lib/email.ts).
#
# Gmail이면 SMTP_PASS는 계정 비밀번호가 아니라 앱 비밀번호(16자리)다:
#   2단계 인증을 켠 뒤 https://myaccount.google.com/apppasswords 에서 발급.
# 포트는 465(암묵적 TLS)만 지원한다 — 이유는 app/lib/smtp.ts 머리말 참고.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 주소 부분이 SMTP_USER와 달라지면 Gmail이 거절하거나 조용히 바꿔 버린다
EMAIL_FROM=debateCode <hicecorp.team@gmail.com>
# 답장 받을 주소 (비우면 EMAIL_FROM)
EMAIL_REPLY_TO=
# EHLO에 쓸 이름 (비우면 NEXT_PUBLIC_SITE_URL의 호스트)
SMTP_EHLO_NAME=

# 자체 도메인으로 옮길 때를 위한 대안 경로. SMTP 설정이 있으면 무시된다.
RESEND_API_KEY=

# ---------- 선택: WebAuthn(보안키) ----------

# 배포 도메인 기준. 예: RPID=debatecode.org, ORIGIN=https://debatecode.org
NEXT_PUBLIC_WEBAUTHN_RPID=
NEXT_PUBLIC_WEBAUTHN_ORIGIN=

# ---------- AI (Hugging Face 단일 키) ----------
# Debate Free AI · debateQ 빌트인 · AI Search · 번역이 전부 이 키 하나를 쓴다.
# 없으면 AI 기능이 규칙 기반 폴백으로 내려간다(서비스는 계속 동작한다).
#
# 기본 모델은 DeepSeek Coder-V2. 모델 추가·교체는 app/lib/ai/free-ai-models.ts의
# FREE_AI_REPOS 표에서 하고, env는 건드리지 않는다.
#
# ⚠ OpenAI·Claude·Gemini·Grok·Perplexity 키는 넣지 않는다 —
#   상용 API는 이용자가 설정 화면에서 자기 키를 등록해 쓴다.

HUGGINGFACE_API_KEY=

# ---------- 선택: 외부 위젯 ----------

# 채널톡 플러그인 키 — 미설정 시 위젯 비활성 (빌드 변수)
NEXT_PUBLIC_CHANNEL_PLUGIN_KEY=

# Google Picker (AI Search 첨부의 "Drive에서 파일 추가") — 빌드 변수
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
