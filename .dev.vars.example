# .dev.vars — 로컬 Workers 미리보기(`npm run preview`)에서 읽는 환경변수.
#
# 이 파일을 `.dev.vars`로 복사해 값을 채운다(.dev.vars는 gitignore됨).
# `next dev`는 `.env`를 읽고, `npm run preview`(workerd)는 `.dev.vars`를 읽는다 —
# 두 파일의 값이 어긋나면 "dev에서는 되는데 preview에서 안 되는" 상황이 된다.
#
# ⚠ NEXT_PUBLIC_* 은 런타임 변수가 아니라 **빌드 시점에 번들로 인라인**된다.
#   프로덕션에서는 `wrangler secret put`이 아니라 빌드 환경변수로 넣어야 한다.
#   자세한 내용은 DEPLOY.md 참고.

# ---------- 필수 ----------

# Supabase Postgres — Workers에서는 pooler(6543, pgbouncer) URL을 써야 한다
DATABASE_URL=
# 마이그레이션용 직결 URL (5432)
DIRECT_URL=

# 빌드 변수 (NEXT_PUBLIC_*) — 클라이언트 번들에 인라인된다
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 — 절대 클라이언트에 노출 금지
SUPABASE_SERVICE_ROLE_KEY=

# 사용자 저장 개인정보/API 키 암호화 키 (AES-256, app/lib/crypto.ts)
AI_SECRET_KEY=
# 이중 암호화 2차 키 (권장, 없으면 1차 키만 사용)
AI_SECRET_KEY_2=

# ---------- 선택: 사이트 정보 ----------

# 절대 URL이 필요한 곳(메일 링크, OAuth 리다이렉트)에서 쓴다
NEXT_PUBLIC_SITE_URL=

# ---------- 선택: 소셜 로그인 ----------

# 네이버 개발자센터 애플리케이션 정보
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ---------- 선택: 메일 발송 (Resend) ----------

# 없으면 dry-run — 콘솔 화면은 동작하되 실제로 보내지 않는다(app/lib/email.ts)
RESEND_API_KEY=
EMAIL_FROM=

# ---------- 선택: WebAuthn(보안키) ----------

# 배포 도메인 기준. 예: RPID=debatecode.kr, ORIGIN=https://debatecode.kr
NEXT_PUBLIC_WEBAUTHN_RPID=
NEXT_PUBLIC_WEBAUTHN_ORIGIN=

# ---------- 선택: Debate Free AI 업스트림 ----------
# 있는 키의 모델만 카탈로그에 노출된다(app/lib/ai/free-ai.ts).
# 한 곳이 장애일 때는 콘솔 › 시스템 › 런타임 설정에서 기본 공급자를 바꿀 수 있다.

OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_AI_API_KEY=
GROK_API_KEY=
HUGGINGFACE_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

# 계열별 모델 오버라이드 (비우면 코드 기본값)
FREE_AI_GEMMA_MODEL=
FREE_AI_GROQ_MODEL=
FREE_AI_GROK_MODEL=
FREE_AI_HF_MODEL=

# ---------- 선택: debateQ 빌트인 모델 ----------
# 미설정 시 규칙 기반 폴백으로 동작한다

AI_BUILTIN_PROVIDER=
AI_BUILTIN_MODEL=
AI_BUILTIN_API_KEY=
AI_BUILTIN_BASE_URL=

# ---------- 선택: 외부 위젯 ----------

# 채널톡 플러그인 키 — 미설정 시 위젯 비활성 (빌드 변수)
NEXT_PUBLIC_CHANNEL_PLUGIN_KEY=

# Google Picker (AI Search 첨부의 "Drive에서 파일 추가") — 빌드 변수
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
