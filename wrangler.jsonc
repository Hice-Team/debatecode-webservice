{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "debate-project",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // 자기 자신을 가리키는 서비스 바인딩 — OpenNext가 요구한다(공식 get-started).
  // 캐시 재검증(revalidatePath)처럼 워커가 자기 자신을 다시 불러야 하는 경로에서 쓰인다.
  // "service" 값은 위의 "name"과 반드시 같아야 한다.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "debate-project"
    }
  ],

  // next/image 최적화 — 이 바인딩이 없으면 Workers에서 이미지 최적화가 동작하지 않는다.
  // app/components/footer.tsx · nav-logo.tsx가 next/image를 쓴다.
  "images": {
    "binding": "IMAGES"
  },

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      // 100% 샘플링 — 초기 운영에서는 전부 남긴다. 트래픽이 커지면 낮춘다.
      "head_sampling_rate": 1,
      // 요청 단위 요약 로그(상태코드·소요시간) — 배포 후 장애 추적의 기본 재료
      "invocation_logs": true
    }
  }

  // ── 요금제에 따라 켤 수 있는 항목 (Workers Paid 필요, 켜기 전 대시보드에서 확인) ──
  //
  // "placement": { "mode": "smart" }
  //   DB 왕복이 잦은 앱이라 오리진(Supabase ap-northeast-2) 근처에서 도는 편이 빠르다.
  //
  // "limits": { "cpu_ms": 60000 }
  //   Prisma WASM 쿼리 컴파일 + 렌더가 겹치는 페이지의 CPU 여유.
  //
  // 정기 작업(cron)은 두지 않는다. OpenNext가 만드는 worker.js에는 `scheduled`
  // 핸들러가 없어서, 트리거만 걸면 매 실행이 그대로 실패한다. 제재 만료 같은
  // 시간 기반 상태는 읽는 시점에 `expiresAt > now`로 판정한다(app/lib/moderation.ts).
}
